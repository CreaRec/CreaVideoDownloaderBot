# Server bootstrap only (copy to the deploy directory as .env).
# App secrets live in config/settings.json on the server.
# Deploy is via GitHub Actions on push to main — not from this machine.

DOWNLOAD_DIR=/mnt/synology/video
IMAGE=ghcr.io/crearec/crea-video-downloader
IMAGE_TAG=main

# OpenTelemetry → CreaGrafana Alloy (Docker network `lgtm`)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_SERVICE_NAME=crea-video-downloader
OTEL_SERVICE_NAMESPACE=bots
DEPLOY_ENV=production
# Optional: OTEL_SERVICE_VERSION=sha-abc1234
